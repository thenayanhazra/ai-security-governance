{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thenayanhazra/ai-security-governance/schemas/threats.schema.json",
  "title": "Agentic AI Reference Threat Model",
  "type": "object",
  "required": ["components", "threats"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^C[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "why"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "components",
          "scenario",
          "owasp_llm",
          "owasp_asi",
          "mitre_atlas",
          "controls",
          "test"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^C[0-9]+$" },
            "uniqueItems": true
          },
          "scenario": { "type": "string", "minLength": 1 },
          "owasp_llm": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "owasp_asi": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "mitre_atlas": {
            "type": "array",
            "items": { "type": "string", "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$" },
            "uniqueItems": true
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$" },
            "uniqueItems": true
          },
          "test": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
